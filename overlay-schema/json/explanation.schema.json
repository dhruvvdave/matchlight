{
  "$id": "https://matchlight.dev/schema/1.0.0/explanation.schema.json",
  "title": "Explanation",
  "x-schema-version": "1.0.0",
  "$ref": "#/definitions/Explanation",
  "definitions": {
    "Explanation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "moment_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "goal",
            "big_chance",
            "save",
            "card",
            "red_card",
            "substitution",
            "tactical_shift",
            "momentum_swing",
            "pressing_shift",
            "speed_flag",
            "difficult_pass",
            "xg_swing",
            "tempo_change",
            "chaos_spike",
            "possession_dominance",
            "player_milestone",
            "period_summary"
          ]
        },
        "ts": {
          "type": "number"
        },
        "minute_label": {
          "type": "string"
        },
        "team": {
          "type": "string",
          "enum": [
            "home",
            "away"
          ]
        },
        "player_id": {
          "type": "string"
        },
        "claim": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fact_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "fact_id",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "unit": {
                "type": "string"
              },
              "previous": {
                "type": "number"
              },
              "delta": {
                "type": "number"
              },
              "team": {
                "type": "string",
                "enum": [
                  "home",
                  "away"
                ]
              },
              "player_id": {
                "type": "string"
              },
              "window": {
                "type": "object",
                "properties": {
                  "from_ts": {
                    "type": "number"
                  },
                  "to_ts": {
                    "type": "number"
                  }
                },
                "required": [
                  "from_ts",
                  "to_ts"
                ],
                "additionalProperties": false
              },
              "event_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label",
              "value",
              "event_ids",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "llm",
            "template"
          ]
        },
        "critic": {
          "type": "object",
          "properties": {
            "grounded": {
              "type": "boolean"
            },
            "attempts": {
              "type": "integer"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "unknown_fact",
                      "unknown_event",
                      "unsupported_number",
                      "unsupported_entity",
                      "direction_mismatch",
                      "schema",
                      "empty_evidence",
                      "overconfident",
                      "too_many_numbers"
                    ]
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "detail"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "grounded",
            "attempts",
            "issues"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "moment_id",
        "kind",
        "ts",
        "minute_label",
        "claim",
        "evidence",
        "confidence",
        "event_ids",
        "facts",
        "source",
        "critic"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
