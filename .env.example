# ─── Matchlight configuration. Copy to .env. Everything is optional: with nothing set the app runs fully
# ─── offline (mock LLM, localised templates, local Web PubSub emulator, in-memory store).

PORT=8787
CORS_ORIGIN=*
MAX_SESSIONS=25

# Azure OpenAI / Azure AI Foundry (Explainer, Narrator, Recap, Ask, LLM translation fallback)
# MATCHLIGHT_LLM=azure                 # 'mock' forces offline mode
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_API_KEY=                # omit to use Entra ID / managed identity (recommended)

# Azure AI Translator (glossary-pinned multilingual narrative)
# AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=westeurope
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Azure AI Speech (neural TTS for commentary + narrated recap MP3)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope

# Azure Web PubSub (real-time push). Without it a local emulator speaks the same protocol.
# WEBPUBSUB_ENDPOINT=https://<name>.webpubsub.azure.com   # managed identity
# WEBPUBSUB_CONNECTION_STRING=                             # or a connection string
# WEBPUBSUB_HUB=matchlight

# Azure Cosmos DB (match state: events, explanations, recaps)
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# COSMOS_KEY=                          # omit to use managed identity
# COSMOS_DATABASE=matchlight

# Offline mock LLM behaviour
MOCK_LLM_LATENCY_MS=250-900            # simulated model latency (exercises the async path + fallbacks)
MOCK_HALLUCINATION_RATE=0.2            # share of first drafts with an injected error for the Critic to catch
NARRATIVE_BUDGET_MS=6000               # LLM narrative must arrive within this or the template line stays
TRACE_LOG=0                            # 1 = log every agent span as JSON (-> Log Analytics in Azure)
